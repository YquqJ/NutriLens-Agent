# ============================================================
# NutriLens 健康管理智能助手 — 环境变量模板
# 使用方法：复制为 backend/.env 并填入真实值（.env 已被 gitignore）
# ============================================================

# ---- 数据库（docker compose 起的 pgvector 容器）----
DATABASE_URL=postgresql+psycopg://nutrilens:nutrilens@localhost:5433/nutrilens

# ---- 阿里云 DashScope（LLM / Embedding / Rerank 统一入口）----
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxx
# OpenAI 兼容模式端点（langchain-openai / openai SDK 都指向这里调 Qwen）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- JWT 认证 ----
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=1440

# ---- 阿里云 OSS（食物图片存储）----
OSS_ACCESS_KEY_ID=xxx
OSS_ACCESS_KEY_SECRET=xxx
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket
# 前端展示用的访问域名（bucket 公开读时即 bucket 默认域名）
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# ---- 可观测：LangSmith 追踪（可选，调试 agent 执行流程用）----
# 开启后，每条对话的完整执行轨迹（路由决策/工具调用/中断点）会 POST 到 LangSmith，
# 在 https://smith.langchain.com 的网页里按时间轴回看。获取 API Key：
# smith.langchain.com → 登录 → 创建项目 → Settings → API Keys（lsv2_ 开头）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nutrilens
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
